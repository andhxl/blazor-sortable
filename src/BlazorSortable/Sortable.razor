@typeparam TItem

<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@Class"
     style="@Style">
    @if (Items is not null && ChildContent is not null)
    {
        @foreach (var item in Items)
        {
            if (UseItemKeys)
            {
                <div @key="GetItemKey(item)" class="@GetItemClass(item)">
                    @ChildContent(item)
                </div>
            }
            else
            {
                <div class="@GetItemClass(item)">
                    @ChildContent(item)
                </div>
            }
        }
    }
</div>
