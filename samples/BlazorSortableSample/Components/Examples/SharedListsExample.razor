<ExampleSection Id="@Id"
                Title="Shared lists"
                CodeContent="@codeContent">
    <RadzenStack Orientation="Orientation.Horizontal">
        <Sortable TItem="ClassA"
                  Items="classAItems1"
                  Class="items-column"
                  Group="group1">
            <RadzenCard class="item">
                @context
            </RadzenCard>
        </Sortable>

        <Sortable TItem="ClassA"
                  Items="classAItems2"
                  Class="items-column"
                  Group="group1">
            <RadzenCard class="item">
                @context
            </RadzenCard>
        </Sortable>
    </RadzenStack>
</ExampleSection>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; }

    private readonly IList<ClassA> classAItems1 = Utils.CreateItemList<ClassA>(5);
    private readonly IList<ClassA> classAItems2 = Utils.CreateItemList<ClassA>(5, 6);

    private string codeContent = @"
<div class=""row"">
    <Sortable TItem=""ClassA""
              Items=""classAItems1""
              Class=""items-column""
              Group=""group1"">
        <div class=""item"">
            @context
        </div>
    </Sortable>

    <Sortable TItem=""ClassA""
              Items=""classAItems2""
              Class=""items-column""
              Group=""group1"">
        <div class=""item"">
            @context
        </div>
    </Sortable>
</div>";
}
