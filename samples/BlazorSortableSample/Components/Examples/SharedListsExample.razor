@implements IExample

<ExampleSection Id="@Id"
                Title="@Title"
                CodeContent="@CodeContent">
    <RadzenStack Orientation="Orientation.Horizontal">
        <Sortable Items="classAItems1"
                  Class="items-column"
                  Group="shared-lists">
            <RadzenCard class="item">
                @context
            </RadzenCard>
        </Sortable>

        <Sortable Items="classAItems2"
                  Class="items-column"
                  Group="shared-lists">
            <RadzenCard class="item">
                @context
            </RadzenCard>
        </Sortable>
    </RadzenStack>
</ExampleSection>

@code {
    public static string Id => "shared-lists";
    public static string Title => "Shared lists";

    private readonly IList<ClassA> classAItems1 = Utils.CreateItemList<ClassA>(5);
    private readonly IList<ClassA> classAItems2 = Utils.CreateItemList<ClassA>(5, 6);

    private const string CodeContent = @"
<div class=""items-row"">
    <Sortable Items=""classAItems1""
              Class=""items-column""
              Group=""shared-lists"">
        <div class=""item"">
            @context
        </div>
    </Sortable>

    <Sortable Items=""classAItems2""
              Class=""items-column""
              Group=""shared-lists"">
        <div class=""item"">
            @context
        </div>
    </Sortable>
</div>

@code {
    private readonly IList<ClassA> classAItems1 = Utils.CreateItemList<ClassA>(5);
    private readonly IList<ClassA> classAItems2 = Utils.CreateItemList<ClassA>(5, 6);
}";
}
