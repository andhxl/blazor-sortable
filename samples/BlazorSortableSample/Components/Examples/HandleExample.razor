@implements IExample

<ExampleSection Id="@Id"
                Title="@Title"
                CodeContent="@CodeContent">
    <Sortable Items="classAItems"
              Class="items-column"
              Handle=".handle"
              ForceFallback="false">
        <RadzenCard class="item">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center">
                <div class="handle" />
                @context
            </RadzenStack>
        </RadzenCard>
    </Sortable>
</ExampleSection>

@code {
    public static string Id => "handle";
    public static string Title => "Handle";
    
    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);

    private const string CodeContent = @"
<Sortable Items=""classAItems""
          Class=""items-column""
          Handle="".handle""
          ForceFallback=""false"">
    <div class=""item item-with-handle"">
        <span class=""handle""></span>
        @context
    </div>
</Sortable>

@code {
    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);
}";
}
