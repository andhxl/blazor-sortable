<ExampleSection Id="@Id"
                Title="Drop zone"
                CodeContent="@codeContent">
    <RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal">
            <Sortable Items="classAItems"
                      Class="items-column"
                      Group="drop1">
                <RadzenCard class="item">
                    @context
                </RadzenCard>
            </Sortable>

            <Sortable Items="classBItems"
                      Class="items-column"
                      Group="drop2">
                <RadzenCard class="item">
                    @context
                </RadzenCard>
            </Sortable>
        </RadzenStack>

        <Sortable TItem="object"
                  Class="drop-zone"
                  Put="SortablePutMode.Groups"
                  PutGroups="@(["drop1", "drop2"])"
                  GhostClass="drop-zone-ghost" />
    </RadzenStack>
</ExampleSection>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; }

    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);
    private readonly IList<ClassB> classBItems = Utils.CreateItemList<ClassB>(5);

    private string codeContent = @"
<div class=""stack"">
    <div class=""row"">
        <Sortable Items=""classAItems""
                  Class=""items-column""
                  Group=""drop1"">
            <div class=""item"">
                @context
            </div>
        </Sortable>

        <Sortable Items=""classBItems""
                  Class=""items-column""
                  Group=""drop2"">
            <div class=""item"">
                @context
            </div>
        </Sortable>
    </div>

    <Sortable TItem=""object""
              Class=""drop-zone""
              Put=""SortablePutMode.Groups""
              PutGroups=""@([""drop1"", ""drop2""])""
              GhostClass=""drop-zone-ghost"" />
</div>

@code {
    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);
    private readonly IList<ClassB> classBItems = Utils.CreateItemList<ClassB>(5);
}";
}
