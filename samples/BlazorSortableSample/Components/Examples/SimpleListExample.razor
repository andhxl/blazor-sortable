<ExampleSection Id="@Id"
                Title="Simple list"
                CodeContent="@codeContent">
    <Sortable Items="classAItems"
              Class="items-column"
              Delay="150"
              DelayOnTouchOnly="true">
        <RadzenCard class="item">
            @context
        </RadzenCard>
    </Sortable>
</ExampleSection>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; }

    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);

    private string codeContent = @"
<Sortable Items=""classAItems""
          Class=""items-column""
          Delay=""150""
          DelayOnTouchOnly=""true"">
    <div class=""item"">
        @context
    </div>
</Sortable>

@code {
    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);
}";
}
