<ExampleSection Id="@Id"
                Title="Swap"
                CodeContent="@codeContent">
    <RadzenStack Orientation="Orientation.Horizontal">
        <Sortable Items="classAItems1"
                  Class="items-column"
                  Swap="true"
                  Group="swap">
            <RadzenCard class="item">
                @context
            </RadzenCard>
        </Sortable>

        <Sortable Items="classAItems2"
                  Class="items-column"
                  Swap="true"
                  Group="swap">
            <RadzenCard class="item">
                @context
            </RadzenCard>
        </Sortable>
    </RadzenStack>
</ExampleSection>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; }

    private readonly IList<ClassA> classAItems1 = Utils.CreateItemList<ClassA>(5);
    private readonly IList<ClassA> classAItems2 = Utils.CreateItemList<ClassA>(5, 6);

    private string codeContent = @"
<div class=""row"">
    <Sortable Items=""classAItems1""
              Class=""items-column""
              Swap=""true""
              Group=""swap"">
        <div class=""item"">
            @context
        </div>
    </Sortable>

    <Sortable Items=""classAItems2""
              Class=""items-column""
              Swap=""true""
              Group=""swap"">
        <div class=""item"">
            @context
        </div>
    </Sortable>
</div>

@code {
    private readonly IList<ClassA> classAItems1 = Utils.CreateItemList<ClassA>(5);
    private readonly IList<ClassA> classAItems2 = Utils.CreateItemList<ClassA>(5, 6);
}";
}
