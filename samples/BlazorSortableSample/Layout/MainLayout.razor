@inherits LayoutComponentBase

<RadzenComponents />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="0">
            <RadzenSidebarToggle Click="() => sidebarExpanded = !sidebarExpanded" />
            <RadzenLabel Text="BlazorSortableSample" />
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar Style="width: fit-content;"
                   @bind-Expanded="sidebarExpanded">
        <RadzenPanelMenu>
            @foreach (var example in ExampleCatalog.All)
            {
                <RadzenPanelMenuItem Text="@example.Title"
                                     Path="@ExampleCatalog.GetPath(example.Id)" />
            }
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>

@code {
    bool sidebarExpanded = true;
}
