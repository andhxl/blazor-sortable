@attribute [Route(ExampleCatalog.RouteTemplate)]

@if (example is not null)
{
    <CascadingValue Value="ResetExample" IsFixed="true">
        <ErrorBoundary @key="(Id, resetToken)">
            <DynamicComponent Type="@example.Value.Type" />
        </ErrorBoundary>
    </CascadingValue>
}
else
{
    <NotFound />
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private (Type Type, string Id, string Title)? example;

    protected override void OnParametersSet()
    {
        example = ExampleCatalog.Find(Id);
    }

    private int resetToken;

    private void ResetExample() => resetToken++;
}
