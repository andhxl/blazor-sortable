@attribute [Route(ExampleCatalog.RouteTemplate)]

@if (example is not null)
{
    <ExampleSection Title="@example.Title"
                    Code="@example.Code"
                    Reset="ResetExample">
        <ErrorBoundary @key="(example.Id, resetToken)">
            <DynamicComponent Type="example.Type" />
        </ErrorBoundary>
    </ExampleSection>
}
else
{
    <NotFound />
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private ExampleDefinition? example;

    protected override void OnParametersSet()
    {
        example = ExampleCatalog.Find(Id);
    }

    private int resetToken;
    private void ResetExample() => resetToken++;
}
