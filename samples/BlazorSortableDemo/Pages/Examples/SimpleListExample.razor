@implements IExample

<ExampleSection Id="@Id"
                Title="@Title"
                CodeContent="@CodeContent">
    <Sortable Items="classAItems"
              Class="items-column">
        <RadzenCard class="item">
            @context
        </RadzenCard>
    </Sortable>
</ExampleSection>

@code {
    public static string Id => "simple-list";
    public static string Title => "Simple list";

    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);

    private const string CodeContent = @"
<Sortable Items=""classAItems""
          Class=""items-column"">
    <div class=""item"">
        @context
    </div>
</Sortable>

@code {
    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);
}";
}
