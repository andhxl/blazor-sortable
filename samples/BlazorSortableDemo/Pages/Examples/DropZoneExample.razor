@implements IExample
@inject NotificationService NotificationService

<RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal">
        <Sortable Items="classAItems"
                  Class="items-column"
                  Group="drop-items-a">
            <RadzenCard class="item">
                @context
            </RadzenCard>
        </Sortable>

        <Sortable Items="classBItems"
                  Class="items-column"
                  Group="drop-items-b">
            <RadzenCard class="item">
                @context
            </RadzenCard>
        </Sortable>
    </RadzenStack>

    <Sortable TItem="object"
              Class="drop-zone"
              PutMode="SortablePutMode.Groups"
              PutGroups="@(["drop-items-a", "drop-items-b"])"
              OnAdd="OnDrop"
              GhostClass="drop-zone-ghost" />
</RadzenStack>

@code {
    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);
    private readonly IList<ClassB> classBItems = Utils.CreateItemList<ClassB>(5);

    private void OnDrop(SortableEventArgs<object> args)
    {
        NotificationService.Notify(
            summary: "Item dropped",
            detail: args.Item.ToString() ?? "Unknown item");
    }

    public static string Id => "drop-zone";
    public static string Title => "Drop zone";

    public static string Code => @"
<div class=""column"">
    <div class=""row"">
        <Sortable Items=""classAItems""
                  Class=""items-column""
                  Group=""drop-items-a"">
            <div class=""item"">
                @context
            </div>
        </Sortable>

        <Sortable Items=""classBItems""
                  Class=""items-column""
                  Group=""drop-items-b"">
            <div class=""item"">
                @context
            </div>
        </Sortable>
    </div>

    <Sortable TItem=""object""
              Class=""drop-zone""
              PutMode=""SortablePutMode.Groups""
              PutGroups=""@([""drop-items-a"", ""drop-items-b""])""
              OnAdd=""OnDrop""
              GhostClass=""drop-zone-ghost"" />

    @if (droppedItem is not null)
    {
        <p>Item dropped: @droppedItem</p>
    }
</div>

@code {
    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);
    private readonly IList<ClassB> classBItems = Utils.CreateItemList<ClassB>(5);

    private string? droppedItem;

    private void OnDrop(SortableEventArgs<object> args)
    {
        droppedItem = args.Item.ToString() ?? ""Unknown item"";
    }
}
";
}
