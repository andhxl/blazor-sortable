@implements IExample
@inject NotificationService NotificationService

<ExampleSection Id="@Id"
                Title="@Title"
                CodeContent="@CodeContent">
    <RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal">
            <Sortable Items="classAItems"
                      Class="items-column"
                      Group="drop-items-a">
                <RadzenCard class="item">
                    @context
                </RadzenCard>
            </Sortable>

            <Sortable Items="classBItems"
                      Class="items-column"
                      Group="drop-items-b">
                <RadzenCard class="item">
                    @context
                </RadzenCard>
            </Sortable>
        </RadzenStack>

        <Sortable TItem="object"
                  Class="drop-zone"
                  Put="SortablePutMode.Groups"
                  PutGroups="@(["drop-items-a", "drop-items-b"])"
                  OnAdd="OnDrop"
                  GhostClass="drop-zone-ghost" />
    </RadzenStack>
</ExampleSection>

@code {
    public static string Id => "drop-zone";
    public static string Title => "Drop zone";

    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);
    private readonly IList<ClassB> classBItems = Utils.CreateItemList<ClassB>(5);

    private void OnDrop(SortableEventArgs<object> args)
    {
        NotificationService.Notify(
            summary: "Item dropped",
            detail: args.Item?.ToString() ?? "Unknown item");
    }

    private const string CodeContent = @"
<div class=""drop-zone-example"">
    <div class=""items-row"">
        <Sortable Items=""classAItems""
                  Class=""items-column""
                  Group=""drop-items-a"">
            <div class=""item"">
                @context
            </div>
        </Sortable>

        <Sortable Items=""classBItems""
                  Class=""items-column""
                  Group=""drop-items-b"">
            <div class=""item"">
                @context
            </div>
        </Sortable>
    </div>

    <Sortable TItem=""object""
              Class=""drop-zone""
              Put=""SortablePutMode.Groups""
              PutGroups=""@([""drop-items-a"", ""drop-items-b""])""
              OnAdd=""OnDrop""
              GhostClass=""drop-zone-ghost"" />

    @if (droppedItem is not null)
    {
        <p>Item dropped: @droppedItem</p>
    }
</div>

@code {
    private readonly IList<ClassA> classAItems = Utils.CreateItemList<ClassA>(5);
    private readonly IList<ClassB> classBItems = Utils.CreateItemList<ClassB>(5);

    private string? droppedItem;

    private void OnDrop(SortableEventArgs<object> args)
    {
        droppedItem = args.Item?.ToString() ?? ""Unknown item"";
    }
}";
}
